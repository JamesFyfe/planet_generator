{
  "name": "planet-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @planet/explorer dev",
    "build": "pnpm --filter @planet/engine --filter @planet/renderer --filter @planet/explorer build",
    "test": "pnpm --filter @planet/engine --filter @planet/renderer --filter @planet/explorer test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @planet/engine --filter @planet/renderer --filter @planet/explorer typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "perf": "pnpm --filter @planet/explorer build && pnpm --filter @planet/explorer exec playwright install chromium && pnpm --filter @planet/explorer perf"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
